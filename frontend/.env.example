# Copie para .env.local e ajuste. O .env.local não vai para o Git.

# Endereço da API (backend FastAPI)
VITE_API_URL=http://localhost:8000/api

# F2: posição da clínica, usada só no navegador do tutor para calcular
# os minutos de deslocamento. A coordenada do tutor nunca é enviada à API.
# Valores de exemplo: trocar pela posição da clínica parceira.
VITE_CLINICA_LATITUDE=-22.4878
VITE_CLINICA_LONGITUDE=-47.2133
# Velocidade média usada para converter distância em minutos (km/h)
VITE_VELOCIDADE_MEDIA_KMH=30

# Valores de demonstração combinados no handoff (podem mudar até o fechamento)
VITE_AVISO_FIXO_MIN=20
VITE_MARGEM_SEGURANCA_MIN=10
