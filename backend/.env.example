APP_NAME=Fila Virtual API
# Local simples:
DATABASE_URL=sqlite:///./fila_virtual.db
# Produção PostgreSQL, exemplo:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/fila_virtual
JWT_SECRET=troque-esta-chave
JWT_EXP_MINUTES=480
# Configuração MOCKED aprovada para a entrega congelada em 2026-11-16.
DEFAULT_FIXED_NOTICE_MINUTES=20
LOCATION_RETENTION_MINUTES=60
# Trava técnica de desenvolvimento; não substitui o mínimo acadêmico da coleta.
MIN_SAMPLES_FOR_ESTIMATE=3
# Habilitado para a apresentacao com identificacao explicita da origem MOCKED.
# Altere para false quando o ambiente nao puder usar a massa MOCKED.
ALLOW_MOCKED_ESTIMATES=true
CORS_ORIGINS=http://localhost:3000
