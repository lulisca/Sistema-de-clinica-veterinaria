APP_NAME=Fila Virtual API
# Local simples:
DATABASE_URL=sqlite:///./fila_virtual.db
# Produção PostgreSQL, exemplo:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/fila_virtual
JWT_SECRET=troque-esta-chave
JWT_EXP_MINUTES=480
# Definir somente após validação da clínica:
# DEFAULT_FIXED_NOTICE_MINUTES=20
# Trava técnica de desenvolvimento; não substitui o mínimo acadêmico da coleta.
MIN_SAMPLES_FOR_ESTIMATE=3
CORS_ORIGINS=http://localhost:3000
