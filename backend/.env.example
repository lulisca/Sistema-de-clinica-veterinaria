APP_NAME=Fila Virtual API
# Local simples:
DATABASE_URL=sqlite:///./fila_virtual.db
# Produção PostgreSQL, exemplo:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/fila_virtual
JWT_SECRET=troque-esta-chave
JWT_EXP_MINUTES=480
# Valores abaixo são parâmetros operacionais pendentes de validação com a clínica.
# Para demonstração local, use valores provisórios e identifique-os como tal.
DEFAULT_FIXED_NOTICE_MINUTES=20  # SOMENTE DEMONSTRAÇÃO LOCAL; validar com a clínica antes de publicar
LOCATION_RETENTION_MINUTES=60  # SOMENTE DEMONSTRAÇÃO LOCAL; validar com a equipe/clínica antes de publicar
# Trava técnica de desenvolvimento; não substitui o mínimo acadêmico da coleta.
MIN_SAMPLES_FOR_ESTIMATE=3
CORS_ORIGINS=http://localhost:3000
